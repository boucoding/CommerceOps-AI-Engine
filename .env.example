# ==============================================================================
# CommerceOps AI Engine - Environment Configuration
# ==============================================================================

# LLM Configuration (REQUIRED FOR LIVE LLM EXECUTION)
# Provide your standard OpenAI API key or custom proxy key here:
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI API Base URL (leave blank for default OpenAI endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Database & pgvector Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@postgres-db:5432/commerceops
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=commerceops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Enterprise Brand Settings
BRAND_NAME=Aura Fashion Atelier
BRAND_SIGNATURE=Aura Customer Experience Concierge
SUPPORT_EMAIL=concierge@aurafashion.com
PHONE_NUMBER=+1 (800) 555-AURA

# System Settings
LOG_LEVEL=INFO
