# CommerceOps AI Engine configuration. Copy to .env and adjust.
# Never commit .env: it holds secrets.

# ---------------------------------------------------------------- LLM
# auto    = live when OPENAI_API_KEY is set, else replay fixtures, else offline rules
# live    = call OpenAI
# record  = call OpenAI and save every answer to REPLAY_FIXTURES_PATH
# replay  = deterministic answers from REPLAY_FIXTURES_PATH (no key needed)
# offline = deterministic rules and templates only
LLM_MODE=auto
OPENAI_API_KEY=
# Leave unset for the standard OpenAI endpoint.
OPENAI_BASE_URL=
LLM_MODEL=gpt-6-luna
# Leave unset to use the model's default sampling temperature.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REPLAY_FIXTURES_PATH=fixtures/llm_replays.json
# Optional: USD per 1M tokens, adds an estimated cost to run summaries.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# ---------------------------------------------------------------- Storage
# memory for local runs; docker compose always uses postgres.
STORAGE_BACKEND=memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commerceops
POSTGRES_USER=commerceops
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional full DSN; overrides the POSTGRES_* values above.
DATABASE_URL=

# ---------------------------------------------------------------- API
# When set, /v1 endpoints require the X-API-Key header.
API_KEY=
API_PORT=8000
API_MAX_BATCH=100

# ---------------------------------------------------------------- Processing
BATCH_WORKERS=4
ORDER_CANDIDATE_TOP_K=5
INQUIRY_TOP_K=4

# ---------------------------------------------------------------- Brand
BRAND_NAME=Aura Fashion Atelier
AGENT_NAME=The Aura Concierge Team
SUPPORT_EMAIL=concierge@aurafashion.com
PHONE_NUMBER=+1 (800) 555-2872

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
