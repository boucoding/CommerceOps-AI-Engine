# CommerceOps AI Engine configuration. Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------- LLM
# live   = call OpenAI (needs OPENAI_API_KEY)
# record = call OpenAI and save every exchange to REPLAY_FIXTURES_PATH
# replay = play back a recording; no network, fully deterministic
LLM_MODE=live
OPENAI_API_KEY=
# Leave unset for the standard OpenAI endpoint.
OPENAI_BASE_URL=
LLM_MODEL=gpt-6-luna
# Leave unset to use the model's default temperature.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REPLAY_FIXTURES_PATH=fixtures/llm_recordings.json
# Optional, USD per 1M tokens: adds an estimated cost to run summaries.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# ---------------------------------------------------------------- Agent
AGENT_MAX_STEPS=12
AGENT_MAX_REPLANS=2
AGENT_MAX_ORDER_QUANTITY=50
SEARCH_RESULT_LIMIT=8
SQL_STATEMENT_TIMEOUT_MS=2000
SQL_MAX_ROWS=50

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commerceops
POSTGRES_USER=commerceops
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional full DSN; overrides the POSTGRES_* values above.
DATABASE_URL=

# ---------------------------------------------------------------- API
# When set, /v1 endpoints require the X-API-Key header.
API_KEY=
API_PORT=8000

# ---------------------------------------------------------------- Brand
BRAND_NAME=Aura Fashion Atelier
AGENT_NAME=The Aura Concierge Team
SUPPORT_EMAIL=concierge@aurafashion.com
PHONE_NUMBER=+1 (800) 555-2872

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
